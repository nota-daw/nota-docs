<Project Sdk="Microsoft.NET.Sdk">
  <!-- Headless screenshot harness for the docs: renders real Nota UI (Avalonia.Headless + Skia)
       for the scenes listed in ../manifest.yml. Run through `npm run shots`, not directly. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <NotaRepo Condition="'$(NotaRepo)' == ''">$(MSBuildThisFileDirectory)../../../nota</NotaRepo>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="$(NotaRepo)/src/managed/Nota.App/Nota.App.csproj" />
    <PackageReference Include="Avalonia.Headless" Version="12.0.3" />
    <PackageReference Include="Avalonia.Skia" Version="12.0.3" />
  </ItemGroup>
</Project>
