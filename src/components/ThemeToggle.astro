---
// Replaces Starlight's Dark / Light / Auto dropdown with the sun/moon pair the Nota site
// uses: a segmented group with the current theme lit in the accent. Until a reader picks
// one the site follows the system theme (Starlight's ThemeProvider already applies it
// before first paint); a pick is saved under Starlight's own key, and also kept in memory
// so it holds for the visit when storage is blocked.
const t = Astro.locals.t;
const options = [
  { key: 'dark', label: t('themeSelect.dark'), icon: 'M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z' },
  {
    key: 'light',
    label: t('themeSelect.light'),
    icon: 'M12 17a5 5 0 1 0 0-10 5 5 0 0 0 0 10zM12 1v2M12 21v2M4.2 4.2l1.4 1.4M18.4 18.4l1.4 1.4M1 12h2M21 12h2M4.2 19.8l1.4-1.4M18.4 5.6l1.4-1.4',
  },
];
---

<nota-theme-toggle role="group" aria-label={t('themeSelect.accessibleLabel')}>
  {
    options.map((o) => (
      <button type="button" data-theme-value={o.key} aria-label={o.label} title={o.label} aria-pressed="false">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d={o.icon} />
        </svg>
      </button>
    ))
  }
</nota-theme-toggle>

{/* Inlined so the pressed state is right on first paint. */}
<script is:inline>
  document
    .querySelector('meta[name="theme-color"]')
    ?.setAttribute('content', document.documentElement.dataset.theme === 'light' ? '#e4e5e7' : '#2b2d31');
  document.querySelectorAll('nota-theme-toggle button').forEach((b) => {
    b.setAttribute('aria-pressed', String(b.dataset.themeValue === document.documentElement.dataset.theme));
  });
</script>

<script>
  type Theme = 'dark' | 'light';
  const KEY = 'starlight-theme';
  const query = matchMedia('(prefers-color-scheme: light)');
  const system = (): Theme => (query.matches ? 'light' : 'dark');

  let picked: Theme | null = null;
  try {
    const saved = localStorage.getItem(KEY);
    if (saved === 'dark' || saved === 'light') picked = saved;
  } catch {
    /* storage blocked */
  }

  function apply(theme: Theme) {
    document.documentElement.dataset.theme = theme;
    // Browser chrome follows the site theme, not just the system's.
    document.querySelector('meta[name="theme-color"]')?.setAttribute('content', theme === 'light' ? '#e4e5e7' : '#2b2d31');
    document.querySelectorAll<HTMLButtonElement>('nota-theme-toggle button').forEach((b) => {
      b.setAttribute('aria-pressed', String(b.dataset.themeValue === theme));
    });
  }

  query.addEventListener('change', () => {
    if (!picked) apply(system());
  });

  class NotaThemeToggle extends HTMLElement {
    connectedCallback() {
      apply(picked ?? system());
      this.querySelectorAll<HTMLButtonElement>('button').forEach((b) =>
        b.addEventListener('click', () => {
          picked = b.dataset.themeValue as Theme;
          try {
            localStorage.setItem(KEY, picked);
          } catch {
            /* storage blocked */
          }
          apply(picked);
        }),
      );
    }
  }
  if (!customElements.get('nota-theme-toggle')) customElements.define('nota-theme-toggle', NotaThemeToggle);
</script>

<style>
  nota-theme-toggle {
    display: inline-flex;
    align-self: center;
    flex: none;
    padding: 3px;
    gap: 2px;
    background: var(--nota-well);
    border: 1px solid var(--sl-color-hairline-light);
    border-radius: 3px;
  }
  button {
    width: 28px;
    height: 24px;
    padding: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    border: none;
    border-radius: 2px;
    background: transparent;
    color: var(--sl-color-gray-3);
    cursor: pointer;
  }
  button:hover {
    color: var(--sl-color-white);
    background: var(--nota-hover);
  }
  button[aria-pressed='true'] {
    background: var(--sl-color-accent);
    color: var(--nota-on-accent);
  }
  button:focus-visible {
    outline: 2px solid var(--sl-color-accent);
    outline-offset: 1px;
  }
</style>
