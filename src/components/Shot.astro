---
// <Shot id="devices/volt/signal" alt="…" caption="…" />
// Shows src/assets/shots/dark/<id>.(webp|png) in the dark theme and
// src/assets/shots/light/<id>.* in the light one. With only one variant it is shown in
// both. Ids are listed in shots/manifest.yml; scripts/check.mjs fails on unknown ids.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  id: string;
  alt: string;
  caption?: string;
  /** Display width in CSS px; shots are taken at 2× so this halves them by default. */
  width?: number;
}

const files = import.meta.glob<{ default: ImageMetadata }>('/src/assets/shots/**/*.{webp,png}', {
  eager: true,
});
const find = (theme: string) =>
  files[`/src/assets/shots/${theme}/${Astro.props.id}.webp`]?.default ??
  files[`/src/assets/shots/${theme}/${Astro.props.id}.png`]?.default;

const { id, alt, caption } = Astro.props;
const dark = find('dark');
const light = find('light');
const width = (img?: ImageMetadata) => Astro.props.width ?? (img ? Math.round(img.width / 2) : undefined);
---

<figure class="nota-shot">
  {
    !dark && !light ? (
      <div class="missing"><span>Screenshot <code>{id}</code> not taken yet</span></div>
    ) : (
      <>
        {dark && (
          <Image src={dark} alt={alt} width={width(dark)} class:list={['shot', light ? 'only-dark' : '']} />
        )}
        {light && (
          <Image src={light} alt={alt} width={width(light)} class:list={['shot', dark ? 'only-light' : '']} />
        )}
      </>
    )
  }
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
  .nota-shot {
    margin-block: 1.5rem;
  }
  .shot {
    max-width: 100%;
    height: auto;
    border-radius: 8px;
    border: 1px solid var(--nota-hairline);
  }
  :root[data-theme='light'] .only-dark,
  :root:not([data-theme='light']) .only-light {
    display: none;
  }
  figcaption {
    margin-top: 0.5rem;
    font-size: var(--sl-text-sm);
    color: var(--sl-color-gray-3);
  }
  .missing {
    display: grid;
    place-items: center;
    min-height: 8rem;
    border: 1px dashed var(--nota-border-strong);
    border-radius: 8px;
    color: var(--sl-color-gray-4);
    font-size: var(--sl-text-sm);
  }
</style>
